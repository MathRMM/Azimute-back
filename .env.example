# Copie para .env e preencha. O .env nunca é versionado (SEC05).

# Banco
DB_NOME=azimute
DB_USUARIO=azimute
DB_SENHA=

# Perfil Spring: dev (local, HTTP aceito) ou prod (HTTPS exigido)
SPRING_PROFILES_ACTIVE=dev

# Senha do usuário inicial "admin" (mín. 12 caracteres). Usada a partir da Fase 7;
# remova do .env depois do primeiro boot.
APP_SENHA_INICIAL=
